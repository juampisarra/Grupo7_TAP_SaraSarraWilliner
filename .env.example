# Copiar este archivo a .env. SQLite permite empezar sin una cuenta de Supabase.
DB_ENGINE=sqlite

# Para Supabase: cambiar DB_ENGINE a postgresql y completar los datos de Connect.
# Usar conexion directa o Session pooler (puerto 5432), no una API key.
# Copiar host/usuario exactos del panel; el usuario del pooler incluye el proyecto.
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=

PGPASSWORD=''
PGSSLMODE=require

# Generar una clave propia y guardarla en .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Elastic Cloud: endpoint HTTPS y API key encoded, sin el prefijo ApiKey.
# Opcional: sin estas variables el listado sin texto sigue funcionando.
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=''
ELASTICSEARCH_INDEX=propiedades
